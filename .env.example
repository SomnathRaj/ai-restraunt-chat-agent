# MongoDB connection string. Leave empty until credentials are provided —
# the app boots fine without it; /healthz will report "mongodb": false.
MONGODB_URI=

# Database name within that connection. Defaults to "restaurant_bot" if unset.
MONGODB_DATABASE=

# Google Gemini API key. Leave empty until provided —
# the app boots fine without it; /healthz will report "gemini": false.
GEMINI_API_KEY=

# Optional: override the Gemini model. Defaults to the "-latest" Flash alias
# so the app follows Google's current release instead of a pinned version --
# pinning to a specific dated model (e.g. gemini-2.5-flash-lite) risks it
# being retired by Google later ("This model ... is no longer available to
# new users", a 404 that surfaces to customers as "trouble reaching our AI
# service"). If you do pin one, prefer whatever version Google's own error
# message recommends as the replacement, and expect to revisit it periodically.
GEMINI_MODEL=gemini-flash-latest

# Flask session/signing secret. Set a real random value for anything beyond local dev.
FLASK_SECRET_KEY=

# Comma-separated list of allowed CORS origins for the frontend.
# Keep in sync with PORT below (e.g. http://localhost:3000 if PORT=3000).
CORS_ALLOWED_ORIGINS=http://localhost:5000

FLASK_ENV=development

# Local dev server port. python run.py reads this; default is 5000 if unset.
PORT=5000

# Display name used in the chat UI and (eventually) the system prompt.
RESTRAUNT_NAME=Restaurant Name

# UPI ID (VPA) to receive payments, e.g. restaurant@okhdfcbank. Leave empty
# to skip the UPI payment QR code on printed invoices entirely -- a
# placeholder value would be actively wrong to print, not just incomplete.
UPI_ID=
